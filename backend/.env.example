# Copy to .env for local development. Never commit a real .env.

# SQLite file (default). For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://roadhouse:change-me@localhost:5432/roadhouse
DATABASE_URL=sqlite:///./roadhouse.db

# Set to true to add a made-up sample band the first time the database is empty.
SEED_SAMPLE_DATA=false
