# Copy to .env for local development. Never commit a real .env.

# PostgreSQL. scripts/dev.sh starts this database in a codespace, with this password.
DATABASE_URL=postgresql+psycopg://roadhouse:roadhouse@localhost:5432/roadhouse

# Where backend tests run. It's created automatically if it doesn't exist.
TEST_DATABASE_URL=postgresql+psycopg://roadhouse:roadhouse@localhost:5432/roadhouse_test

# Set to true to add a made-up sample band the first time the database is empty.
SEED_SAMPLE_DATA=false
